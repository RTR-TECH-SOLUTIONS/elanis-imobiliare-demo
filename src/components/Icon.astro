---
// Iconițe line, desenate la 24px cu contur 1.6. Fără set extern, fără emoji.
interface Props {
  nume:
    | 'telefon'
    | 'whatsapp'
    | 'inima'
    | 'foto'
    | 'pin'
    | 'inchide'
    | 'stanga'
    | 'dreapta'
    | 'meniu'
    | 'cauta'
    | 'mail'
    | 'harta'
    | 'lista'
    | 'filtre'
    | 'facebook'
    | 'tiktok';
  class?: string;
  marime?: number;
}
const { nume, class: cls = '', marime = 20 } = Astro.props;
---

<svg
  class={cls}
  width={marime}
  height={marime}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nume === 'telefon' && (
    <path d="M5 4h3.2l1.6 4-2 1.2a11 11 0 0 0 7 7l1.2-2 4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />
  )}
  {nume === 'whatsapp' && (
    <>
      <path d="M4.2 19.8 5.3 16A8 8 0 1 1 8.2 18.8Z" />
      <path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.6 1.4c.1.3 0 .5-.1.7l-.4.5c-.1.2-.1.3 0 .5a5.3 5.3 0 0 0 2.4 2.2c.2.1.4.1.5-.1l.5-.6c.2-.2.4-.2.6-.1l1.4.7c.3.1.3.3.3.5 0 .6-.4 1.3-1 1.5a3.3 3.3 0 0 1-2.4-.3 8.4 8.4 0 0 1-3.8-3.6c-.6-1-.8-2-.4-3Z" />
    </>
  )}
  {nume === 'inima' && <path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.6 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10Z" />}
  {nume === 'foto' && (
    <>
      <rect x="3" y="6" width="18" height="14" rx="2" />
      <path d="M8.5 6 10 4h4l1.5 2" />
      <circle cx="12" cy="13" r="3.5" />
    </>
  )}
  {nume === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {nume === 'inchide' && <path d="M6 6l12 12M18 6 6 18" />}
  {nume === 'stanga' && <path d="M15 5l-7 7 7 7" />}
  {nume === 'dreapta' && <path d="M9 5l7 7-7 7" />}
  {nume === 'meniu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nume === 'cauta' && (
    <>
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4.5 4.5" />
    </>
  )}
  {nume === 'mail' && (
    <>
      <rect x="3" y="5.5" width="18" height="13" rx="2" />
      <path d="m3.5 7 8.5 6 8.5-6" />
    </>
  )}
  {nume === 'harta' && (
    <>
      <path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6 9 4Z" />
      <path d="M9 4v14M15 6v14" />
    </>
  )}
  {nume === 'lista' && <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" />}
  {nume === 'filtre' && <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0M14 4v4M8 10v4M16 16v4" />}
  {nume === 'facebook' && <path d="M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.5-1.5H17V4.5a19 19 0 0 0-2.3-.1C12.4 4.4 11 5.8 11 8.3v2.2H8.5v3H11V21" />}
  {nume === 'tiktok' && <path d="M14 3.5v11.2a3.3 3.3 0 1 1-3.3-3.3M14 3.5c.4 2.5 2.2 4.3 4.8 4.5" />}
