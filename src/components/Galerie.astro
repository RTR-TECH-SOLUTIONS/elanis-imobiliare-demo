---
import Icon from './Icon.astro';
import { pozaUrl } from '../lib/oferta';

interface Props {
  poze: string[];
  titlu: string;
}
const { poze, titlu } = Astro.props;
const n = poze.length;
const vizibile = poze.slice(0, 3);
---

<div class="galerie" data-galerie>
  <!-- desktop: mozaic cu prima poză mare -->
  <div class:list={['mozaic', `n${Math.min(n, 3)}`]}>
    {
      vizibile.map((p, i) => (
        <button type="button" class="tile" data-deschide={i} aria-label={`Deschide fotografia ${i + 1} din ${n}`}>
          <img
            src={pozaUrl(p, i === 0 ? 1600 : 800)}
            alt={i === 0 ? titlu : ''}
            width="1600"
            height="1200"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
          {i === vizibile.length - 1 && n > 1 && (
            <span class="toate">
              <Icon nume="foto" marime={17} /> Toate cele {n} fotografii
            </span>
          )}
        </button>
      ))
    }
  </div>

  <!-- mobil: carusel cu snap -->
  <div class="carusel" data-carusel>
    {
      poze.map((p, i) => (
        <button type="button" class="slide" data-deschide={i} aria-label={`Deschide fotografia ${i + 1} din ${n}`}>
          <img src={pozaUrl(p, 800)} alt={i === 0 ? titlu : ''} width="800" height="600" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </button>
      ))
    }
  </div>
  <p class="contor-mobil cifre" data-contor-mobil>1 / {n}</p>

  <dialog class="lightbox" data-lightbox aria-label={`Fotografii: ${titlu}`}>
    <div class="lb-cap">
      <p class="cifre" data-lb-contor>1 / {n}</p>
      <button type="button" class="lb-buton" data-lb-inchide aria-label="Închide galeria"><Icon nume="inchide" marime={24} /></button>
    </div>
    <div class="lb-scena" data-lb-scena>
      <img data-lb-img alt="" />
    </div>
    {
      n > 1 && (
        <>
          <button type="button" class="lb-buton lb-nav stanga" data-lb-inapoi aria-label="Fotografia anterioară">
            <Icon nume="stanga" marime={26} />
          </button>
          <button type="button" class="lb-buton lb-nav dreapta" data-lb-inainte aria-label="Fotografia următoare">
            <Icon nume="dreapta" marime={26} />
          </button>
        </>
      )
    }
    <script type="application/json" data-lb-poze set:html={JSON.stringify(poze.map((p) => pozaUrl(p, 1600)))} />
  </dialog>
</div>

<style>
  .mozaic {
    display: none;
  }
  .tile,
  .slide {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-foto);
    background: var(--color-paper-2);
    cursor: zoom-in;
  }
  .tile img,
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-iesire);
  }
  .tile:hover img {
    transform: scale(1.025);
  }
  .toate {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 12px;
    border-radius: 8px;
    background: #fff;
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 1px 4px rgb(19 35 46 / 0.2);
  }
  .carusel {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .carusel::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 88%;
    aspect-ratio: 4 / 3;
    scroll-snap-align: center;
  }
  .contor-mobil {
    margin-top: 8px;
    color: var(--color-ink-3);
    font-size: 0.875rem;
  }
  @media (min-width: 768px) {
    .carusel,
    .contor-mobil {
      display: none;
    }
    .mozaic {
      display: grid;
      gap: 10px;
      height: clamp(360px, 42vw, 540px);
    }
    .mozaic.n1 {
      grid-template-columns: 1fr;
    }
    .mozaic.n2 {
      grid-template-columns: 1.6fr 1fr;
    }
    .mozaic.n3 {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .mozaic.n3 .tile:first-child {
      grid-row: 1 / span 2;
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0b141b;
    color: #fff;
  }
  .lightbox::backdrop {
    background: #0b141b;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .lb-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px 10px 20px;
    font-size: 0.95rem;
  }
  .lb-scena {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 0 0 24px;
    touch-action: pan-y;
  }
  .lb-scena img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  @media (min-width: 768px) {
    .lb-scena {
      padding: 0 88px 32px;
    }
  }
  .lb-buton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    color: #fff;
    transition: background-color 150ms var(--ease-iesire);
  }
  .lb-buton:hover {
    background: rgb(255 255 255 / 0.1);
  }
  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgb(255 255 255 / 0.08);
  }
  .lb-nav.stanga {
    left: 16px;
  }
  .lb-nav.dreapta {
    right: 16px;
  }
  @media (max-width: 767px) {
    .lb-nav {
      top: auto;
      bottom: 20px;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-galerie]').forEach((g) => {
    const dialog = g.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const contor = dialog.querySelector<HTMLElement>('[data-lb-contor]')!;
    const poze = JSON.parse(dialog.querySelector('[data-lb-poze]')!.textContent!) as string[];
    let i = 0;
    let deschisDe: HTMLElement | null = null;

    function arata(k: number) {
      i = (k + poze.length) % poze.length;
      img.src = poze[i];
      img.alt = `Fotografia ${i + 1} din ${poze.length}`;
      contor.textContent = `${i + 1} / ${poze.length}`;
      // preîncarcă vecina, ca navigarea să fie instantă
      const urm = new Image();
      urm.src = poze[(i + 1) % poze.length];
    }

    g.querySelectorAll<HTMLElement>('[data-deschide]').forEach((b) =>
      b.addEventListener('click', () => {
        deschisDe = b;
        arata(Number(b.dataset.deschide));
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      deschisDe?.focus();
    });
    dialog.querySelector('[data-lb-inchide]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-inapoi]')?.addEventListener('click', () => arata(i - 1));
    dialog.querySelector('[data-lb-inainte]')?.addEventListener('click', () => arata(i + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') arata(i - 1);
      if (e.key === 'ArrowRight') arata(i + 1);
    });

    // Swipe pe telefon.
    const scena = dialog.querySelector<HTMLElement>('[data-lb-scena]')!;
    let x0: number | null = null;
    scena.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    scena.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) arata(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    // Contorul caruselului de pe mobil.
    const carusel = g.querySelector<HTMLElement>('[data-carusel]')!;
    const cm = g.querySelector<HTMLElement>('[data-contor-mobil]')!;
    carusel.addEventListener(
      'scroll',
      () => {
        const w = carusel.firstElementChild ? (carusel.firstElementChild as HTMLElement).offsetWidth + 8 : 1;
        cm.textContent = `${Math.min(poze.length, Math.round(carusel.scrollLeft / w) + 1)} / ${poze.length}`;
      },
      { passive: true },
    );
  });
</script>
