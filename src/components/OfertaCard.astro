---
import Icon from './Icon.astro';
import type { Oferta } from '../data/oferte';
import { caracteristici, linkOferta, locText, numar, numeEticheta, pozaUrl, pretMp, pretText } from '../lib/oferta';

interface Props {
  o: Oferta;
  /** primele carduri din pagină se încarcă imediat */
  prioritar?: boolean;
}
const { o, prioritar = false } = Astro.props;
const mp = pretMp(o);
---

<article
  class="card group"
  data-card
  data-id={o.id}
  data-tranzactie={o.tranzactie}
  data-tip={o.tip}
  data-zona={o.zona}
  data-pret={o.pret}
  data-camere={o.camere ?? 0}
  data-suprafata={o.suprafata ?? o.teren ?? 0}
  data-adaugat={o.adaugat}
  data-etichete={o.etichete.join(' ')}
>
  <div class="foto">
    <img
      src={pozaUrl(o.poze[0], 800)}
      alt={o.titlu}
      width="800"
      height="600"
      loading={prioritar ? 'eager' : 'lazy'}
      decoding="async"
    />
    {
      o.etichete.length > 0 && (
        <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
          {o.etichete.map((e) => (
            <span class={`eticheta eticheta-${e}`}>{numeEticheta[e]}</span>
          ))}
        </div>
      )
    }
    <button type="button" class="salveaza" data-favorit={o.id} aria-pressed="false" aria-label={`Salvează: ${o.titlu}`}>
      <Icon nume="inima" marime={19} />
    </button>
    <span class="nr-poze cifre" aria-label={`${o.poze.length} fotografii`}>
      <Icon nume="foto" marime={15} />
      {o.poze.length}
    </span>
  </div>

  <div class="flex flex-1 flex-col pt-4">
    <p class="text-sm text-ink-3">{locText(o.zona)}</p>
    <h3 class="mt-1 text-[1.05rem] leading-snug font-semibold" style="font-stretch:100%">
      <a href={linkOferta(o)} class="titlu-link">{o.titlu}</a>
    </h3>
    <p class="mt-2 mb-4 text-sm text-ink-3">{caracteristici(o).join(' · ')}</p>
    <div class="mt-auto flex items-baseline justify-between gap-3 border-t border-line pt-3">
      <p class="cifre text-ink">
        <span class="lat text-[1.3rem] font-bold">{pretText(o)}</span>
        {o.pretVechi && <s class="ml-1.5 text-sm text-ink-3">{numar(o.pretVechi)} €</s>}
      </p>
      {mp && <p class="cifre text-sm text-ink-3">{mp}</p>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .foto {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-foto);
    background: var(--color-paper-2);
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-iesire);
  }
  .card:hover .foto img {
    transform: scale(1.035);
  }
  /* tot cardul e clicabil prin linkul din titlu */
  .titlu-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .titlu-link:focus-visible {
    outline: none;
  }
  .titlu-link:focus-visible::after {
    outline: 2px solid var(--color-brass);
    outline-offset: 4px;
    border-radius: var(--radius-foto);
  }
  .card:hover .titlu-link {
    text-decoration: underline;
    text-decoration-color: var(--color-brass);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .salveaza {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-ink);
    transition:
      background-color 150ms var(--ease-iesire),
      color 150ms var(--ease-iesire);
  }
  .salveaza:hover {
    background: #fff;
  }
  .salveaza[aria-pressed='true'] {
    background: var(--color-ink);
    color: #fff;
  }
  .salveaza[aria-pressed='true'] :global(path) {
    fill: currentColor;
  }
  .nr-poze {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 8px;
    border-radius: 4px;
    background: rgb(19 35 46 / 0.72);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>
