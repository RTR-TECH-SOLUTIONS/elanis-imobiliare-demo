---
import Icon from './Icon.astro';
import { firma } from '../data/firma';
import { zone } from '../data/zone';
import { cale } from '../lib/oferta';

const an = 2026;
---

<footer class="mt-24 bg-ink text-[#c9d0d5]">
  <div class="container-site grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12">
    <div class="sm:col-span-2 lg:col-span-4">
      <img src={cale('/logo-light.svg')} alt="Elanis Imobiliare" width="220" height="45" class="h-11 w-auto" loading="lazy" />
      <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed">
        Vânzări, cumpărări și închirieri de apartamente, case, terenuri și spații comerciale în Turda și în
        comunele din jur.
      </p>
      <div class="mt-6 flex gap-2">
        <a href={firma.facebook} class="social" aria-label="Elanis Imobiliare pe Facebook" rel="noopener" target="_blank"
          ><Icon nume="facebook" /></a
        >
        <a href={firma.tiktok} class="social" aria-label="Elanis Imobiliare pe TikTok" rel="noopener" target="_blank"
          ><Icon nume="tiktok" /></a
        >
      </div>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-base text-white">Oferte</h2>
      <ul class="mt-4 space-y-2.5 text-[0.95rem]">
        <li><a class="lf" href={cale('/oferte/?tranzactie=vanzare&tip=apartament')}>Apartamente de vânzare</a></li>
        <li><a class="lf" href={cale('/oferte/?tranzactie=inchiriere')}>De închiriat</a></li>
        <li><a class="lf" href={cale('/oferte/?tip=casa')}>Case</a></li>
        <li><a class="lf" href={cale('/oferte/?tip=teren')}>Terenuri</a></li>
        <li><a class="lf" href={cale('/oferte/?tip=spatiu')}>Spații comerciale</a></li>
        <li><a class="lf" href={cale('/vinde/')}>Vinde prin Elanis</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-base text-white">Cartiere</h2>
      <ul class="mt-4 space-y-2.5 text-[0.95rem]">
        {
          zone.slice(0, 6).map((z) => (
            <li>
              <a class="lf" href={cale(`/oferte/?zona=${z.slug}`)}>
                {z.nume}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:col-span-2 lg:col-span-3">
      <h2 class="text-base text-white">Contact</h2>
      <ul class="mt-4 space-y-2.5 text-[0.95rem]">
        <li><a class="lf cifre text-lg font-semibold text-white" href={firma.telefonLink}>{firma.telefon}</a></li>
        <li><a class="lf break-all" href={`mailto:${firma.email}`}>{firma.email}</a></li>
        <li>{firma.zona}</li>
      </ul>
      <dl class="mt-5 space-y-1 text-sm">
        {
          firma.program.map((p) => (
            <div class="flex justify-between gap-4 border-b border-white/10 pb-1">
              <dt>{p.zile}</dt>
              <dd class="text-right text-white">{p.ore}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-3 py-6 text-sm text-[#9aa6ae] md:flex-row md:items-center md:justify-between">
      <p>© {an} {firma.nume}. Toate drepturile rezervate.</p>
      <p>
        Foto Turda: Cristian Chirita,{' '}
        <a class="underline underline-offset-2 hover:text-white" href="https://creativecommons.org/licenses/by/2.5/" rel="noopener" target="_blank"
          >CC BY 2.5</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .lf {
    transition: color 150ms var(--ease-iesire);
  }
  .lf:hover {
    color: #fff;
  }
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 8px;
    color: #fff;
    transition: border-color 150ms var(--ease-iesire);
  }
  .social:hover {
    border-color: var(--color-brass);
  }
</style>
