---
// Calcul orientativ de rată (anuitate constantă). Funcționează și pe pagina
// ofertei, unde prețul vine completat.
// TODO(real): dobânda de referință se actualizează din admin, lunar.
interface Props {
  pret?: number;
  compact?: boolean;
}
const { pret = 85000, compact = false } = Astro.props;
const uid = `calc-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['calc', compact && 'compact']} data-calculator>
  <div class="campuri">
    <div class="col-span-2">
      <label class="eticheta-camp" for={`${uid}-pret`}>Prețul locuinței</label>
      <div class="cu-unitate">
        <input
          id={`${uid}-pret`}
          class="camp cifre"
          type="text"
          inputmode="numeric"
          value={new Intl.NumberFormat('ro-RO').format(pret)}
          data-c="pret"
        />
        <span>€</span>
      </div>
    </div>
    <div>
      <label class="eticheta-camp" for={`${uid}-avans`}>Avans</label>
      <select id={`${uid}-avans`} class="camp cifre" data-c="avans">
        <option value="5">5% (Noua Casă)</option>
        <option value="15" selected>15%</option>
        <option value="20">20%</option>
        <option value="25">25%</option>
        <option value="30">30%</option>
      </select>
    </div>
    <div>
      <label class="eticheta-camp" for={`${uid}-ani`}>Perioadă</label>
      <select id={`${uid}-ani`} class="camp cifre" data-c="ani">
        <option value="15">15 ani</option>
        <option value="20">20 de ani</option>
        <option value="25">25 de ani</option>
        <option value="30" selected>30 de ani</option>
      </select>
    </div>
    <div class="col-span-2">
      <label class="eticheta-camp" for={`${uid}-dob`}>Dobândă anuală <span class="font-normal text-ink-3">(<output data-o="dob">6,4</output>%)</span></label>
      <input id={`${uid}-dob`} class="slider" type="range" min="4" max="10" step="0.1" value="6.4" data-c="dob" />
    </div>
  </div>

  <div class="rezultat" aria-live="polite">
    <p class="text-sm text-ink-3">Rata lunară estimată</p>
    <p class="suma cifre"><output data-o="rata">–</output> <span>€ / lună</span></p>
    <dl class="detalii cifre">
      <div><dt>Avans</dt><dd><output data-o="avans">–</output> €</dd></div>
      <div><dt>Credit</dt><dd><output data-o="credit">–</output> €</dd></div>
      <div><dt>Dobândă totală</dt><dd><output data-o="total">–</output> €</dd></div>
    </dl>
    <p class="mt-4 text-[0.82rem] leading-relaxed text-ink-3">
      Calcul orientativ, cu dobândă fixă pe toată perioada. Oferta reală o dă banca, după analiza veniturilor.
    </p>
  </div>
</div>

<style>
  .calc {
    display: grid;
    gap: 24px;
  }
  .campuri {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .cu-unitate {
    position: relative;
  }
  .cu-unitate .camp {
    padding-right: 2.2rem;
    font-weight: 600;
  }
  .cu-unitate span {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-ink-3);
    pointer-events: none;
  }
  .slider {
    width: 100%;
    height: 44px;
    accent-color: var(--color-ink);
    cursor: pointer;
  }
  .rezultat {
    padding: 22px;
    border-radius: var(--radius-panou);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }
  .suma {
    margin-top: 2px;
    color: var(--color-ink);
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3rem);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.1;
  }
  .suma span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink-3);
    font-stretch: 100%;
  }
  .detalii {
    margin-top: 16px;
    border-top: 1px solid var(--color-line);
  }
  .detalii div {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.925rem;
  }
  .detalii dt {
    color: var(--color-ink-3);
  }
  .detalii dd {
    color: var(--color-ink);
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .calc:not(.compact) {
      grid-template-columns: 1.1fr 1fr;
      gap: 40px;
      align-items: start;
    }
  }
</style>

<script>
  const nr = new Intl.NumberFormat('ro-RO', { maximumFractionDigits: 0 });

  document.querySelectorAll<HTMLElement>('[data-calculator]').forEach((c) => {
    const camp = (k: string) => c.querySelector<HTMLInputElement>(`[data-c="${k}"]`)!;
    const out = (k: string) => c.querySelector<HTMLOutputElement>(`[data-o="${k}"]`)!;

    function calculeaza() {
      const pret = Number(camp('pret').value.replace(/\D/g, '')) || 0;
      const avans = (pret * Number(camp('avans').value)) / 100;
      const credit = pret - avans;
      const n = Number(camp('ani').value) * 12;
      const dob = Number(camp('dob').value);
      const r = dob / 100 / 12;
      const rata = r === 0 ? credit / n : (credit * r) / (1 - Math.pow(1 + r, -n));
      out('dob').textContent = dob.toFixed(1).replace('.', ',');
      out('rata').textContent = pret ? nr.format(rata) : '–';
      out('avans').textContent = nr.format(avans);
      out('credit').textContent = nr.format(credit);
      out('total').textContent = nr.format(Math.max(0, rata * n - credit));
    }

    // Prețul se formatează cu puncte pe măsură ce se scrie.
    camp('pret').addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      const cifre = el.value.replace(/\D/g, '').slice(0, 8);
      el.value = cifre ? nr.format(Number(cifre)) : '';
      calculeaza();
    });
    c.addEventListener('input', calculeaza);
    c.addEventListener('change', calculeaza);
    calculeaza();
  });
</script>
